SettingsTab:Section({
    Title = "Performance",
})

local FPSBoostEnabled = false

local SavedLighting = {
    GlobalShadows = Lighting.GlobalShadows,
    FogEnd = Lighting.FogEnd,
    Brightness = Lighting.Brightness,
}

local SavedEffects = {}

local EffectClasses = {
    ParticleEmitter = true,
    Trail = true,
    Beam = true,
    Smoke = true,
    Fire = true,
}

local function OptimizeObject(obj)
    if not EffectClasses[obj.ClassName] then return end
    if SavedEffects[obj] == nil then
        SavedEffects[obj] = obj.Enabled
    end
    pcall(function()
        obj.Enabled = false
    end)
end

local function SetFPSBoost(enabled)
    FPSBoostEnabled = enabled

    if enabled then
        SavedLighting.GlobalShadows = Lighting.GlobalShadows
        SavedLighting.FogEnd = Lighting.FogEnd
        SavedLighting.Brightness = Lighting.Brightness

        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 100000
            Lighting.Brightness = 1
        end)

        for _, obj in ipairs(Workspace:GetDescendants()) do
            OptimizeObject(obj)
        end

        WindUI:Notify({
            Title = "FPS Optimizer",
            Content = "Optimization enabled.",
            Duration = 2,
        })
    else
        pcall(function()
            Lighting.GlobalShadows = SavedLighting.GlobalShadows
            Lighting.FogEnd = SavedLighting.FogEnd
            Lighting.Brightness = SavedLighting.Brightness
        end)

        for obj, state in pairs(SavedEffects) do
            if obj and obj.Parent then
                pcall(function()
                    obj.Enabled = state
                end)
            end
        end

        table.clear(SavedEffects)

        WindUI:Notify({
            Title = "FPS Optimizer",
            Content = "Optimization disabled.",
            Duration = 2,
        })
    end
end

SettingsTab:Toggle({
    Title = "FPS Optimizer",
    Desc = "Reduce particles, shadows and visual effects.",
    Value = false,

    Callback = function(Value)
        SetFPSBoost(Value)
    end,
})

Workspace.DescendantAdded:Connect(function(obj)
    if FPSBoostEnabled then
        task.defer(function()
            OptimizeObject(obj)
        end)
    end
end)

