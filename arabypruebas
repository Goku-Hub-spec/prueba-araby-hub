        }
    end)
end

local function UpdatePlayerESP()
    if not PlayerESPEnabled then return end

    pcall(function()
        local myCharacter = LocalPlayer.Character
        if not myCharacter then return end

        local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")

                if root then
                    if not PlayerESPObjects[player] then
                        CreatePlayerESP(player)
                    end

                    local data = PlayerESPObjects[player]
                    if data and data.Label then
                        local distance = (myRoot.Position - root.Position).Magnitude
                        data.Label.Text = string.format("%s\n%d m", player.Name, math.floor(distance + 0.5))
                    end
                else
                    RemovePlayerESP(player)
                end
            end
        end
    end)
end

local function SetPlayerESP(enabled)
    PlayerESPEnabled = enabled

    if enabled then
        for _, player in ipairs(Players:GetPlayers()) do
            CreatePlayerESP(player)
        end

        if not PlayerESPConnection then
            PlayerESPConnection = RunService.RenderStepped:Connect(UpdatePlayerESP)
        end

        WindUI:Notify({
            Title = "Player ESP",
            Content = "Player names ENABLED",
            Duration = 2,
        })
    else
        for player in pairs(PlayerESPObjects) do
            RemovePlayerESP(player)
        end

        if PlayerESPConnection then
            PlayerESPConnection:Disconnect()
            PlayerESPConnection = nil
        end

        WindUI:Notify({
            Title = "Player ESP",
            Content = "Player names DISABLED",
            Duration = 2,
        })
    end
end

